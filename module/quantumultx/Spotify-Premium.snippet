# 最后修改：2026-11-24 02:07
# Spotify 会员（QX 版）
# 改编自 Reukix 的 Spotify Premium v2026.11.16.1，脚本都由我们自己维护，放在仓库 script/ 文件夹里
# QX 版不带开关，脚本用默认：歌词补全开、歌词翻译开、翻译目标语言中文；想改开关用 Egern 版
# 会员和去广告永远开着，没有总开关
[general]
name=Spotify 会员
description=会员配置、首页与播放页去广告，歌词补全和双语翻译（QX 版无开关）
author=YuTalk
homepage=https://github.com/YuTalk/tool
icon=https://raw.githubusercontent.com/YuTalk/tool/main/icon/spotify.png

[rule]
DOMAIN,aet.spotify.com,REJECT

[rewrite_local]
^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon url 307 reject
^https:\/\/.*-spclient\.spotify\.com(:443)?\/pam-view-service\/ url 307 reject
^https:\/\/.*37i9dQZF1EYkqdzj48dyYq url 307 reject
^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service url 307 reject

[script]
spotify-home = type=http-response,pattern=^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/casita\/v1\/home\/default\/?(?:\?[^#]*)?$,requires-body=1,binary-body-mode=1,max-size=2097152,script-path=https://raw.githubusercontent.com/YuTalk/tool/main/script/spotify-home.js,timeout=5
spotify-search = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse,requires-body=1,binary-body-mode=1,max-size=2097152,script-path=https://raw.githubusercontent.com/YuTalk/tool/main/script/spotify-search.js,timeout=5
spotify-scroll=type=http-response,pattern=^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/scrollsita\/v[0-9]+\/scroll\/spotify:[^?#]+(?:\?[^#]*)?$,requires-body=true,binary-body-mode=true,max-size=2097152,timeout=8,script-path=https://raw.githubusercontent.com/YuTalk/tool/main/script/spotify-lyrics.js
spotify-lyrics=type=http-response,pattern=^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/color-lyrics\/v2\/track\/[A-Za-z0-9]{22}(?:\/image\/[^/?#]+)?\/?(?:\?[^#]*)?$,requires-body=true,binary-body-mode=true,max-size=2097152,timeout=20,script-path=https://raw.githubusercontent.com/YuTalk/tool/main/script/spotify-lyrics.js
spotify-lyrics-metadata=type=http-response,pattern=^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:extended-metadata\/v0\/extended-metadata|metadata\/4\/track\/[a-fA-F0-9]{32})(?:\?[^#]*)?$,requires-body=true,binary-body-mode=true,max-size=2097152,script-path=https://raw.githubusercontent.com/YuTalk/tool/main/script/spotify-lyrics.js,timeout=5
spotify-lyrics-playback=type=http-response,pattern=^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/connect-state\/v1\/devices\/[^/?#]+(?:\?[^#]*)?$,requires-body=true,binary-body-mode=true,max-size=2097152,script-path=https://raw.githubusercontent.com/YuTalk/tool/main/script/spotify-lyrics.js,timeout=5
spotify-proto = type=http-response,pattern=^https:\/\/(?:[A-Za-z0-9-]+-)?spclient(?:\.wg)?\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize|nebula\/v1\/configuration\/attributes|remote-config-resolver\/v3\/configuration)\/?(?:\?[^#]*)?$,requires-body=1,binary-body-mode=1,max-size=2097152,script-path=https://raw.githubusercontent.com/YuTalk/tool/main/script/spotify-proto.js,script-update-interval=86400,timeout=5

[mitm]
hostname = *.spotify.com
