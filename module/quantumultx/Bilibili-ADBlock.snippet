#!name=哔哩哔哩去广告
#!desc=去开屏广告、搜索热词
#!author=YuTalk
#!homepage=https://github.com/YuTalk/tool
# 最后修改：2026-11-23 23:26
# 精简版：之前完整版把 B站的接口拦错了导致首页加载失败，先只留最稳的两条
# 注意：不要和别的哔哩哔哩模块同时开

[rewrite_local]
# 开屏广告，直接拒绝
^https?://app\.bili(bili\.com|api\.net)/x/v2/splash/(brand/list|event/list2|list|show)(\?.*)?$ url 307 http://reject/
# 搜索框下面的热词推荐，直接拒绝
^https?://(grpc|app)\.bili(bili\.com|api\.net)/bilibili\.app\.interface\.v1\.Search/DefaultWords$ url 307 http://reject/

[mitm]
hostname = app.bilibili.com, app.biliapi.net, grpc.bilibili.com, grpc.biliapi.net
